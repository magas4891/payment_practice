<div class="min-h-[calc(100vh-6rem)] bg-neutral-950 text-stone-200 py-12 px-6">
  <div class="max-w-3xl mx-auto">
    <header class="mb-6">
      <h1 class="font-serif text-4xl font-normal text-white tracking-tight">Subscription cancelled</h1>
      <p class="text-neutral-400 text-sm mt-2">
        You can choose a plan again whenever you’re ready.
      </p>
    </header>

    <% if flash[:alert].present? %>
      <div class="bg-rose-400/10 border border-rose-400/30 text-rose-200 rounded-2xl p-6 mb-6">
        <p class="text-sm"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6">
      <div class="text-sm text-neutral-300">
        Choose a subscription plan:
      </div>
      <div class="mt-5">
        <%= button_to "Browse plans", subscriptions_new_path,
                      method: :get,
                      class: "w-full inline-flex items-center justify-center px-5 py-3 bg-amber-400 hover:bg-amber-300 text-neutral-950 rounded-xl text-sm font-semibold transition-colors" %>
      </div>
    </div>
  </div>
</div>
