<div class="min-h-[calc(100vh-6rem)] bg-neutral-950 text-stone-200 py-12 px-6">
  <div class="max-w-3xl mx-auto">
    <header class="mb-6">
      <h1 class="font-serif text-4xl font-normal text-white tracking-tight">Stripe Billing Portal</h1>
      <p class="text-neutral-400 text-sm mt-2">If you were redirected here, we’ll send you to Stripe next.</p>
    </header>

    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6">
      <p class="text-sm text-neutral-300">
        Click below if you didn’t automatically continue to Stripe.
      </p>
      <div class="mt-5">
        <%= button_to "Continue to Stripe",
                      subscriptions_portal_path,
                      method: :get,
                      class: "w-full inline-flex items-center justify-center px-5 py-3 bg-amber-400 hover:bg-amber-300 text-neutral-950 rounded-xl text-sm font-semibold transition-colors",
                      form: { data: { turbo: false } } %>
      </div>

      <div class="mt-4">
        <%= link_to "Back to premium content", subscriptions_premium_path,
                    class: "block text-center text-xs text-neutral-500 hover:text-neutral-300 underline underline-offset-4" %>
      </div>
    </div>
  </div>
</div>
