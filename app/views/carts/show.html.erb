<div class="min-h-screen bg-neutral-950 text-stone-200 py-12 px-6">
  <div class="max-w-3xl mx-auto">

    <%# Header %>
    <div class="flex items-baseline gap-4 mb-12 pb-6 border-b border-neutral-800">
      <h1 class="font-serif text-4xl font-normal text-white tracking-tight">Your Cart</h1>
      <span class="text-sm text-neutral-500"><%= @cart.cart_items.count %> items</span>
    </div>

    <%# Items %>
    <div id="cart-items" class="flex flex-col gap-0.5 mb-8">
      <%= render @cart.cart_items %>
    </div>

    <%# Summary %>
    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8">
      <div class="flex justify-between items-center py-3 text-sm text-neutral-400 border-b border-neutral-800">
        <span>Subtotal</span>
        <span id="subtotal-price"><%= number_to_currency(@cart.total_price / 100.0) %></span>
      </div>
      <div class="flex justify-between items-center py-3 text-sm text-neutral-400 border-b border-neutral-800">
        <span>Shipping</span>
        <span>Free</span>
      </div>

      <div class="flex justify-between items-center pt-5 mt-2 border-t border-neutral-700">
        <span class="font-serif text-xl text-stone-200">Total</span>
        <span id="total-price" class="text-3xl font-semibold text-amber-400 tracking-tight">
          <%= number_to_currency(@cart.total_price / 100.0) %>
        </span>
      </div>

      <%= button_to "Proceed to Checkout →",
                    checkout_path,
                    method: :post,
                    class: "w-full mt-6 py-4 bg-amber-400 hover:bg-amber-300 text-neutral-950
                    font-semibold text-sm rounded-xl transition-all duration-150
                    hover:-translate-y-0.5 active:translate-y-0 cursor-pointer" %>

      <p class="text-center text-xs text-neutral-600 mt-4">🔒 Secured by Stripe · SSL encrypted</p>
    </div>

  </div>
</div>
